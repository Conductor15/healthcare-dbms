# Copy to .env (never commit .env). Used by docker-compose AND the server.

# SQL Server: password must have 8+ chars incl. upper, lower, digit, symbol
MSSQL_SA_PASSWORD=Healthcare@2026
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=HealthcareDB

# Cassandra
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_LOCAL_DC=dc1
CASSANDRA_KEYSPACE=healthcare

# API server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
